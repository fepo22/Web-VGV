PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

USERS_FILE=./data/users.json
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=vgv
AUTO_SYNC_SEED=false
